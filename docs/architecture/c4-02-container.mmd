---
config:
  layout: elk
  theme: base
  themeVariables:
    fontSize: 15px
    lineColor: '#4b5563'
    primaryTextColor: '#111111'
    clusterBkg: '#eef2f7'
    clusterBorder: '#64748b'
  elk:
    mergeEdges: true
    nodePlacementStrategy: NETWORK_SIMPLEX
---
graph TB
  classDef person fill:#0b3d61,stroke:#062033,color:#ffffff,stroke-width:2px
  classDef container fill:#2a6fb0,stroke:#0b3d61,color:#ffffff,stroke-width:2px
  classDef store fill:#d97706,stroke:#451a03,color:#ffffff,stroke-width:2px
  classDef ext fill:#5c6670,stroke:#2b3036,color:#ffffff,stroke-width:2px

  emp["Employee / Apprentice<br/><i>[Person]</i>"]:::person
  adm["Facilities / Admin Staff<br/><i>[Person]</i>"]:::person
  led["LED Matrix Display<br/><i>[Software System]</i>"]:::ext

  subgraph boundary["Parkit - Heroku app &quot;parkit-bsl&quot;"]
    web["Web Application<br/><i>[Rails 7.2 / Puma - web dyno]</i><br/>Server-rendered ERB + Hotwire UI,<br/>Devise+Okta auth, Pundit authz,<br/>session-auth JSON API v1"]:::container
    sched["Scheduled Tasks<br/><i>[Rake - one-off dyno]</i><br/>Monthly billing run &amp;<br/>invoice status sync"]:::container
    db[("PostgreSQL<br/><i>[Heroku Postgres]</i><br/>Users, reservations, spots,<br/>vehicles, invoices")]:::store
  end

  okta["Okta<br/><i>[External System]</i><br/>SSO / OIDC"]:::ext
  cashctrl["CashCtrl<br/><i>[External System]</i><br/>Invoicing SaaS"]:::ext
  slack["Slack<br/><i>[External System]</i><br/>Notifications"]:::ext

  emp -->|"HTTPS"| web
  adm -->|"HTTPS"| web
  led -->|"JSON / HTTPS"| web

  web -->|"reads &amp; writes (SQL)"| db
  sched -->|"reads &amp; writes (SQL)"| db

  web -->|"OIDC login"| okta
  web -->|"REST: persons, invoices, PDFs"| cashctrl
  web -->|"Web API (prod only)"| slack
  sched -->|"REST: billing, status sync"| cashctrl
